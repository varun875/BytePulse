<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="BytePulse.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="20" MaxWidth="900" HorizontalAlignment="Left">

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="BytePulse" />
                <TextBlock
                    Text="A fast, open source disk usage analyzer."
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{StaticResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Border
                Padding="16"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{StaticResource CardStrokeColorDefaultBrush}"
                Background="{StaticResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Last scan" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="LastScanText" Text="Nothing has been scanned yet." TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="RescanButton" Content="Scan again" Click="OnRescan" IsEnabled="False" />
                        <Button x:Name="ResultsButton" Content="Open results" Click="OnOpenResults" IsEnabled="False" />
                        <Button x:Name="MapButton" Content="Open map" Click="OnOpenMap" IsEnabled="False" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Spacing="8">
                <TextBlock Text="Scan a drive" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ItemsControl x:Name="DriveList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto,*,160,Auto" ColumnSpacing="12" Padding="0,6">
                                <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource BodyStrongTextBlockStyle}" MinWidth="70" />
                                <TextBlock Grid.Column="1" Text="{Binding Description}" VerticalAlignment="Center" />
                                <ProgressBar Grid.Column="2" Minimum="0" Maximum="100" Value="{Binding UsedPercent}" VerticalAlignment="Center" />
                                <Button Grid.Column="3" Content="Scan" Tag="{Binding Path}" Click="OnScanDrive" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock
                Text="BytePulse runs entirely on this machine. Nothing is sent anywhere, and the application does not use the network."
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{StaticResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
