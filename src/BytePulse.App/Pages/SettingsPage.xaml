<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="BytePulse.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,16,24,24">
        <StackPanel Spacing="20" MaxWidth="760" HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />

            <StackPanel Spacing="8">
                <TextBlock Text="Scanning" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <Grid ColumnDefinitions="*,200" ColumnSpacing="16" Padding="0,6">
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Threads" />
                        <TextBlock
                            Text="How many directories are read at once. More threads read a large tree faster, up to a point."
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{StaticResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <NumberBox
                        Grid.Column="1"
                        x:Name="ThreadBox"
                        Minimum="1"
                        Maximum="64"
                        SpinButtonPlacementMode="Compact"
                        VerticalAlignment="Center"
                        ValueChanged="OnThreadsChanged" />
                </Grid>

                <ToggleSwitch
                    x:Name="HiddenToggle"
                    Header="Include hidden and system files"
                    Toggled="OnSettingToggled" />

                <ToggleSwitch
                    x:Name="ReparseToggle"
                    Header="Follow junctions and symbolic links"
                    OnContent="Followed"
                    OffContent="Not followed"
                    Toggled="OnSettingToggled" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Detail" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock
                    Text="These two options open every file, so a scan takes noticeably longer. Leave them off unless you need them."
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{StaticResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />

                <ToggleSwitch
                    x:Name="SizeOnDiskToggle"
                    Header="Read the space each file occupies on disk"
                    Toggled="OnSettingToggled" />

                <ToggleSwitch
                    x:Name="HardlinkToggle"
                    Header="Count a file with several hard links once"
                    Toggled="OnSettingToggled" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Results" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <ToggleSwitch
                    x:Name="FoldersFirstToggle"
                    Header="List folders before files"
                    Toggled="OnSettingToggled" />
            </StackPanel>

            <TextBlock
                x:Name="SavedText"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{StaticResource TextFillColorSecondaryBrush}" />

        </StackPanel>
    </ScrollViewer>
</Page>
